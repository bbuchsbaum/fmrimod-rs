+fn ri(model: RepeatedModel, scale: f64, offset: f64) -> PreparedRepeatedModel {
+    let y = [-1., 0., 1., 2.]
+        .iter()
+        .flat_map(|v| vec![v * scale + offset; 3])
+        .collect();
+    prepared(
+        y,
+        3,
+        Array2::ones((12, 1)),
+        Array2::eye(3) * (0.3 * scale * scale),
+        model,
+    )
+    .unwrap()
 }
